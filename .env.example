# Copy to .env.local for local dev. Real values live in Vercel project settings.
# Supabase test project (nail-pos-test). Publishable key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://eoamccaeovuahveytbnr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Real text-code login (Supabase phone auth + Twilio Verify). Leave unset for test codes.
NEXT_PUBLIC_SMS_LOGIN=
# "Continue with Google" (needs SMS_LOGIN on + Google provider set up in Supabase Auth). Leave unset to hide it.
NEXT_PUBLIC_GOOGLE_LOGIN=
# Server only (Vercel, Sensitive). Card payments (session 3):
STRIPE_SECRET_KEY=
# Webhook secrets: see docs/stripe-webhooks.md
STRIPE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
# Stripe Billing webhook (platform account events: salon plans) — endpoint /api/billing/webhook
STRIPE_BILLING_WEBHOOK_SECRET=
# Texting (server only, Vercel Sensitive): Twilio account + the PolishOS Messaging Service (MG…). Unset = texts logged as 'skipped'.
# Twilio webhooks: incoming messages → /api/sms/inbound (STOP/START/HELP). Delivery updates come to /api/sms/status by themselves.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# While testing (trial account): a plain Twilio number instead of the Messaging Service, e.g. +15105550100
TWILIO_FROM=
